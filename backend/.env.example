# Backend port
PORT=5000

# Local MongoDB (for development)
MONGO_URI=mongodb://localhost:27017/lexiq

# For production (MongoDB Atlas), replace with your Atlas connection string
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/lexiq

# JWT secret (must be changed in real usage)
JWT_SECRET=your_secret_here

# Allowed browser origin(s), comma-separated
CORS_ORIGIN=http://localhost:8080
